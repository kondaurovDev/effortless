{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "effortless-docs",
  "compatibility_date": "2026-05-13",
  "routes": [
    {
      "pattern": "effortless-aws.website",
      "custom_domain": true
    },
    {
      "pattern": "www.effortless-aws.website",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./docs/dist",
    "not_found_handling": "404-page"
  }
}
